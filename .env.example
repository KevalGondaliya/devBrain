# --- Database ---
POSTGRES_USER=devbrain
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=devbrain
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://devbrain:change-me-locally@localhost:5432/devbrain

# --- Auth ---
# Static bearer token(s) for MCP transport auth in local/demo mode.
# Comma-separated "token:role" pairs, e.g. "devtoken123:admin,viewer456:viewer"
MCP_API_TOKENS=devtoken123:admin

# --- Anthropic (only needed for the LIVE demo path; automated tests use the stub) ---
ANTHROPIC_API_KEY=
# real | stub — see docs/architecture/agent-flow.md
DEVBRAIN_LLM_MODE=stub

# --- Embeddings (local, no API key required) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Reliability (Phase 6) ---
# Per-tool-call timeout in seconds, enforced via asyncio.wait_for in
# devbrain_common.mcp_tooling.handle_tool_errors; exceeding it raises a
# structured 504 (UpstreamTimeoutError).
TOOL_TIMEOUT_SECONDS=30

# --- Dummy data generation ---
SEED_DATASET_SIZE=default   # small | default | large
SEED_RANDOM_SEED=42

# --- Knowledge MCP (services/knowledge_mcp) ---
KNOWLEDGE_MCP_TRANSPORT=stdio   # stdio | streamable-http | sse
KNOWLEDGE_MCP_HOST=127.0.0.1
KNOWLEDGE_MCP_PORT=8001
# Role assumed for stdio-transport calls (no bearer token to read locally) —
# second-brain-mcp-plan.md §5's local-dev auth carve-out. viewer | user | admin
KNOWLEDGE_MCP_STDIO_ROLE=admin

# --- Project MCP (services/project_mcp) ---
PROJECT_MCP_TRANSPORT=stdio   # stdio | streamable-http | sse
PROJECT_MCP_HOST=127.0.0.1
PROJECT_MCP_PORT=8002
PROJECT_MCP_STDIO_ROLE=admin

# --- Task MCP (services/task_mcp) ---
TASK_MCP_TRANSPORT=stdio   # stdio | streamable-http | sse
TASK_MCP_HOST=127.0.0.1
TASK_MCP_PORT=8003
TASK_MCP_STDIO_ROLE=admin

# --- GitHub MCP (services/github_mcp) ---
GITHUB_MCP_TRANSPORT=stdio   # stdio | streamable-http | sse
GITHUB_MCP_HOST=127.0.0.1
GITHUB_MCP_PORT=8004
GITHUB_MCP_STDIO_ROLE=admin

# --- Calendar MCP (services/calendar_mcp) ---
CALENDAR_MCP_TRANSPORT=stdio   # stdio | streamable-http | sse
CALENDAR_MCP_HOST=127.0.0.1
CALENDAR_MCP_PORT=8005
CALENDAR_MCP_STDIO_ROLE=admin
