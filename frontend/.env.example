# Base URL the browser uses to reach the FastAPI backend (Phase 8).
#
# - Running the frontend with `npm run dev`/`npm start` directly on the host
#   (not in Docker): point this at the backend's host-mapped port, e.g.
#   http://localhost:8000
# - Running via `docker compose up frontend`: this value is baked in at
#   *build time* (Next.js inlines NEXT_PUBLIC_* vars into the client bundle)
#   and must still be a URL the **browser on the host** can reach, not the
#   backend's compose-internal service name (`http://backend:8000` only
#   resolves *inside* the compose network, not from the host browser making
#   the actual fetch calls) — see docker-compose.yml's `frontend` stanza
#   comment for the full explanation.
NEXT_PUBLIC_API_URL=http://localhost:8000
